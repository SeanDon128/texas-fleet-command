rule StaleTelemetry
	statement: Telemetry is stale strictly when Vehicle.lastTelemetryAt is earlier than ScenarioClock.asOf minus 15 minutes. Equality at the threshold is not stale. Never use wall clock. The scenario clock is 2026-10-27T15:00:00Z.
	lineageTag: 00000000-0000-4000-8000-f80f3b5b4e5b

	ruleReferencedEntity Vehicle
		propertyScope: specific

		ruleReferencedProperty lastTelemetryAt

	ruleReferencedEntity ScenarioClock
		propertyScope: specific

		ruleReferencedProperty asOf
