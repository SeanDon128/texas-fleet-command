          },
          {
            "name": "Vehicle Code",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "string",
            "description": "Unique synthetic display identifier, for example SYN-027. Use for truck/unit questions, not the nonunique source unit field.",
            "lineageTag": "00000000-0000-4000-8000-f777699f7898",
            "sourceColumn": "vehicleCode",
            "sourceLineageTag": "vehicleCode",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "description": "One current row per entirely invented fleet vehicle. Truck, unit, vehicle and fleet asset are synonyms. Current operating status, vehicle health, delay and telemetry freshness are separate dimensions. No live GPS or real-world operations.",
        "lineageTag": "00000000-0000-4000-8000-f52738d4dfcb",
        "measures": [
          {
            "name": "Total Vehicles",
            "expression": "COALESCE(COUNTROWS('Vehicles'), 0)",
            "formatString": "#,##0",
            "description": "Count of synthetic vehicles in the current filter context, never telemetry/assignment/alert rows.",
            "displayFolder": "Fleet",
            "lineageTag": "00000000-0000-4000-8000-fc9758e4b4b0"
          },
          {
            "name": "Active Vehicles",
            "expression": "CALCULATE([Total Vehicles], KEEPFILTERS('Vehicles'[Operating Status] IN {\"en_route\", \"at_stop\", \"idle\"}))",
            "formatString": "#,##0",
            "description": "In-service vehicles: en_route, at_stop or idle. Does not mean moving only, alert-affected or healthy.",
            "displayFolder": "Fleet",
            "lineageTag": "00000000-0000-4000-8000-fa294616c25e"
          },
          {
            "name": "Vehicles With Active Alerts",
            "expression": "COALESCE(COUNTROWS(FILTER('Vehicles', CALCULATE([Active Alerts]) > 0)), 0)",
            "formatString": "#,##0",
            "description": "Distinct vehicles having at least one active alert; counts each vehicle once, even with multiple alerts.",
            "displayFolder": "Attention",
            "lineageTag": "00000000-0000-4000-8000-f1e6bc381eec"
          },
          {
            "name": "Vehicles With Critical Alerts",
            "expression": "COALESCE(COUNTROWS(FILTER('Vehicles', CALCULATE([Critical Alerts]) > 0)), 0)",
            "formatString": "#,##0",
            "description": "Distinct vehicles having at least one active critical alert. Use Vehicle Code for the affected-vehicle list.",
            "displayFolder": "Attention",
            "lineageTag": "00000000-0000-4000-8000-ffd0f60ab07d"
          },
          {
            "name": "Delayed Vehicles",
            "expression": "CALCULATE([Total Vehicles], KEEPFILTERS('Vehicles'[Delay Status] = \"delayed\"))",
            "formatString": "#,##0",
            "description": "Vehicles explicitly delayed. Does not include at_risk or derive delay from an alert type.",
            "displayFolder": "Attention",
            "lineageTag": "00000000-0000-4000-8000-fa01c0e3e606"
          },
          {
            "name": "Vehicles Not Reporting",
            "expression": "VAR Cutoff = [Scenario As Of UTC] - 15.0 / 1440.0\nRETURN COALESCE(COUNTROWS(FILTER('Vehicles', NOT ISBLANK('Vehicles'[Last Telemetry Time]) && 'Vehicles'[Last Telemetry Time] < Cutoff)), 0)",
            "formatString": "#,##0",
            "description": "Stopped reporting/stale telemetry: last report is strictly earlier than scenario now minus 15 minutes. A report exactly 15 minutes old is not stale.",
            "displayFolder": "Attention",
            "lineageTag": "00000000-0000-4000-8000-f4a4f545b94a"
          },
          {
            "name": "Vehicles Reporting Normally",
            "expression": "[Total Vehicles] - [Vehicles Not Reporting]",
            "formatString": "#,##0",
            "description": "Vehicles not flagged stale in the current snapshot. Means reporting freshness, not overall good health or absence of delay/alerts. Source timestamps are non-null.",
            "displayFolder": "Fleet",
            "lineageTag": "00000000-0000-4000-8000-f6b4059f3a4d"
          },
          {
            "name": "Health Attention Vehicles",
            "expression": "CALCULATE([Total Vehicles], KEEPFILTERS('Vehicles'[Health Status] IN {\"watch\", \"service_needed\"}))",
            "formatString": "#,##0",
            "description": "Vehicles whose health is watch or service_needed. Independent of delay, operational status and active alerts.",
            "displayFolder": "Attention",
            "lineageTag": "00000000-0000-4000-8000-f6d80fc91e9e"
          },
          {
            "name": "Out Of Service Vehicles",
            "expression": "CALCULATE([Total Vehicles], KEEPFILTERS('Vehicles'[Operating Status] IN {\"offline\", \"maintenance\"}))",
            "formatString": "#,##0",
            "description": "Vehicles offline or in maintenance; does not itself imply criticality, hazard or real-world unavailability.",
            "displayFolder": "Attention",
            "lineageTag": "00000000-0000-4000-8000-fe796fe7f4a9"
          },
          {
            "name": "Vehicles Needing Attention",
            "expression": "VAR Cutoff = [Scenario As Of UTC] - 15.0 / 1440.0\nRETURN COALESCE(COUNTROWS(FILTER('Vehicles', 'Vehicles'[Delay Status] = \"delayed\" || 'Vehicles'[Health Status] IN {\"watch\", \"service_needed\"} || 'Vehicles'[Operating Status] IN {\"offline\", \"maintenance\"} || (NOT ISBLANK('Vehicles'[Last Telemetry Time]) && 'Vehicles'[Last Telemetry Time] < Cutoff) || CALCULATE([Active Alerts]) > 0)), 0)",
            "formatString": "#,##0",
            "description": "Union of active alert OR delayed OR stale telemetry OR health watch/service_needed OR offline/maintenance. Count each vehicle once; reason counts overlap. A TOP-limited list is not this fleet-wide count.",
            "displayFolder": "Attention",
            "lineageTag": "00000000-0000-4000-8000-fc1f64b54853"
          },
          {
            "name": "Attention Rate",
            "expression": "DIVIDE([Vehicles Needing Attention], [Total Vehicles])",
            "formatString": "0.0%",
            "description": "Share of distinct vehicles needing attention within the selected region or context. Compare rates as well as counts; no sum of overlapping reasons.",
            "displayFolder": "Attention",
            "lineageTag": "00000000-0000-4000-8000-fdf71d81716b"
          },
          {
            "name": "Average Speed En Route (mph)",
            "expression": "CALCULATE(AVERAGE('Vehicles'[Speed (mph)]), KEEPFILTERS('Vehicles'[Operating Status] = \"en_route\"))",
            "formatString": "0.00 \"mph\"",
            "description": "Unweighted mean of latest vehicle speeds for en_route vehicles only. Not a mean across historical telemetry readings, not an average including stopped trucks.",
            "displayFolder": "Fleet",
            "lineageTag": "00000000-0000-4000-8000-f0ff5f2e3a1d"
          }
        ],
        "partitions": [
          {
            "name": "Vehicles",
            "mode": "directLake",
            "source": {
              "entityName": "Vehicles",
              "expressionSource": "DirectLake - OneLake",
              "schemaName": "dbo",
              "type": "entity"
            }
          }
        ],
        "sourceLineageTag": "[dbo].[Vehicles]"
      },
