            "sourceLineageTag": "source",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Alert Status",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "string",
            "description": "open, acknowledged or resolved; active includes open and acknowledged.",
            "lineageTag": "00000000-0000-4000-8000-fe1dd135b8f7",
            "sourceColumn": "status",
            "sourceLineageTag": "status",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Alert Type",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "string",
            "description": "Operational reason: delay, telemetry, health or operations.",
            "lineageTag": "00000000-0000-4000-8000-f171983e40b9",
            "sourceColumn": "type",
            "sourceLineageTag": "type",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Vehicle Key",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "string",
            "description": "Affected vehicle key.",
            "isHidden": true,
            "lineageTag": "00000000-0000-4000-8000-f0e11715be7a",
            "sourceColumn": "vehicle_id",
            "sourceLineageTag": "vehicle_id",
            "summarizeBy": "none"
          },
          {
            "name": "Acknowledged At UTC",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "dateTime",
            "description": "Nullable actual UTC acknowledgement action timestamp.",
            "formatString": "yyyy-MM-dd HH:mm:ss \"UTC\"",
            "lineageTag": "00000000-0000-4000-8000-fa92a7bb49c8",
            "sourceColumn": "acknowledgedAt",
            "sourceLineageTag": "acknowledgedAt",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "description": "One persisted alert per operational condition; multiple alerts can affect one vehicle. Active=open OR acknowledged; resolved is excluded. Status is the current record state, not reconstructed historical state at Scenario As Of. Recipient assignment is not notification delivery.",
        "lineageTag": "00000000-0000-4000-8000-f092bc27a5c8",
        "measures": [
          {
            "name": "Active Alerts",
            "expression": "CALCULATE(COALESCE(COUNTROWS('Alerts'), 0), KEEPFILTERS('Alerts'[Alert Status] IN {\"open\", \"acknowledged\"}))",
            "formatString": "#,##0",
            "description": "Current alert rows with status open or acknowledged. Multiple alerts can affect the same vehicle; excludes resolved, regardless of creation date.",
            "displayFolder": "Alerts",
            "lineageTag": "00000000-0000-4000-8000-f627112e5a34"
          },
          {
            "name": "Critical Alerts",
            "expression": "CALCULATE([Active Alerts], KEEPFILTERS('Alerts'[Severity] = \"critical\"))",
            "formatString": "#,##0",
            "description": "Active critical alert rows; excludes resolved critical alerts. Not a count of all historical critical records.",
            "displayFolder": "Alerts",
            "lineageTag": "00000000-0000-4000-8000-f7fdf02a057a"
          }
        ],
        "partitions": [
          {
            "name": "Alerts",
            "mode": "directLake",
            "source": {
              "entityName": "Alerts",
              "expressionSource": "DirectLake - OneLake",
              "schemaName": "dbo",
              "type": "entity"
            }
          }
        ],
        "sourceLineageTag": "[dbo].[Alerts]"
      },
