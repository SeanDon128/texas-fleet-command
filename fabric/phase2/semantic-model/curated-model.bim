            "summarizeBy": "none"
          }
        ],
        "description": "Fictional vehicle work assignments: 120 current plus completed history in the initial seed. Current means Is Current Assignment=true. Routes and destinations are assignment attributes; no independent location/route master exists.",
        "lineageTag": "00000000-0000-4000-8000-fea8c5872cf0",
        "measures": [
          {
            "name": "Current Assignments",
            "expression": "CALCULATE(COALESCE(COUNTROWS('Assignments'), 0), KEEPFILTERS('Assignments'[Is Current Assignment] = TRUE()))",
            "formatString": "#,##0",
            "description": "Assignment rows explicitly flagged current. Never join/count all assignment history as current work.",
            "displayFolder": "Assignments",
            "lineageTag": "00000000-0000-4000-8000-f0fb8f900fef"
          }
        ],
