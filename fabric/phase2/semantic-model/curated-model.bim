              }
            ],
            "dataType": "string",
            "description": "Region recorded on the event; inactive direct relation avoids ambiguous filter paths.",
            "isHidden": true,
            "lineageTag": "00000000-0000-4000-8000-ff80989fbc4d",
            "sourceColumn": "region_id",
            "sourceLineageTag": "region_id",
            "summarizeBy": "none"
          },
          {
            "name": "Event Type",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "string",
            "description": "status_change, telemetry_lost, telemetry_restored, delay_update, alert_created, alert_acknowledged or alert_resolved.",
            "lineageTag": "00000000-0000-4000-8000-fa483893186c",
            "sourceColumn": "type",
            "sourceLineageTag": "type",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Vehicle Key",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "string",
            "description": "Vehicle associated with this observation/change.",
            "isHidden": true,
            "lineageTag": "00000000-0000-4000-8000-f8819541327b",
            "sourceColumn": "vehicle_id",
            "sourceLineageTag": "vehicle_id",
            "summarizeBy": "none"
          }
        ],
        "description": "Recorded synthetic operational changes. Most events have no alert link. Last scenario hour is Occurred At UTC > Scenario As Of minus one hour AND <= Scenario As Of. Operator workflow events can occur after the frozen scenario hour.",
        "lineageTag": "00000000-0000-4000-8000-fca6b194f6d4",
        "measures": [
          {
            "name": "Events In Last Scenario Hour",
            "expression": "VAR AsOfStamp = [Scenario As Of UTC]\nRETURN COALESCE(COUNTROWS(FILTER('Fleet Events', 'Fleet Events'[Occurred At UTC] > AsOfStamp - 1.0 / 24.0 && 'Fleet Events'[Occurred At UTC] <= AsOfStamp)), 0)",
            "formatString": "#,##0",
            "description": "Events in the interval (scenario as-of minus one hour, scenario as-of]. Later actual-time operator actions are excluded.",
            "displayFolder": "Scenario",
            "lineageTag": "00000000-0000-4000-8000-fdb8a47f583d"
          }
        ],
        "partitions": [
          {
            "name": "FleetEvents",
            "mode": "directLake",
            "source": {
              "entityName": "FleetEvents",
              "expressionSource": "DirectLake - OneLake",
              "schemaName": "dbo",
              "type": "entity"
            }
          }
        ],
        "sourceLineageTag": "[dbo].[FleetEvents]"
      },
