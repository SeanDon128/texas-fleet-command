      {
        "name": "Scenario Clock",
        "columns": [
          {
            "name": "Scenario Key",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "string",
            "description": "Technical stable clock identifier.",
            "isHidden": true,
            "isKey": true,
            "lineageTag": "00000000-0000-4000-8000-f1b3ec02a01c",
            "sourceColumn": "id",
            "sourceLineageTag": "id",
            "summarizeBy": "none"
          },
          {
            "name": "As Of Timestamp UTC",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "dateTime",
            "description": "The authoritative synthetic now in UTC. Never substitute NOW(), TODAY(), latest event time or system time.",
            "formatString": "yyyy-MM-dd HH:mm:ss \"UTC\"",
            "lineageTag": "00000000-0000-4000-8000-fe532443a3b4",
            "sourceColumn": "asOf",
            "sourceLineageTag": "asOf",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Scenario Name",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "string",
            "description": "Synthetic scenario title.",
            "lineageTag": "00000000-0000-4000-8000-f749b813868a",
            "sourceColumn": "scenarioName",
            "sourceLineageTag": "scenarioName",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "description": "Exactly one synthetic scenario clock row; deliberately disconnected. Defines now for telemetry freshness and scenario event windows. Does not advance with wall-clock time or alter current alert status.",
        "lineageTag": "00000000-0000-4000-8000-f70d460411c1",
        "measures": [
          {
            "name": "Scenario As Of UTC",
            "expression": "VAR AsOfStamp = SELECTEDVALUE('Scenario Clock'[As Of Timestamp UTC])\nRETURN IF(ISBLANK(AsOfStamp), ERROR(\"Exactly one scenario as-of timestamp is required.\"), AsOfStamp)",
            "formatString": "yyyy-MM-dd HH:mm:ss \"UTC\"",
            "description": "Authoritative synthetic now for freshness/windows; not wall-clock current time or alert historical reconstruction.",
            "displayFolder": "Scenario",
            "lineageTag": "00000000-0000-4000-8000-f64e41976f0c"
          }
        ],
        "partitions": [
          {
            "name": "SimClocks",
