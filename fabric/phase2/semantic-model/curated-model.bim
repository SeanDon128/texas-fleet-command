              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "string",
            "description": "Region recorded on the alert. Inactive direct relationship; default regional analysis follows current Vehicle region.",
            "isHidden": true,
            "lineageTag": "00000000-0000-4000-8000-fefa3091df9e",
            "sourceColumn": "region_id",
            "sourceLineageTag": "region_id",
            "summarizeBy": "none"
          },
          {
            "name": "Resolved At UTC",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ],
            "dataType": "dateTime",
            "description": "Nullable UTC resolution action timestamp. Resolving an alert does not fix a vehicle condition.",
            "formatString": "yyyy-MM-dd HH:mm:ss \"UTC\"",
            "lineageTag": "00000000-0000-4000-8000-fd97423cdbfc",
            "sourceColumn": "resolvedAt",
            "sourceLineageTag": "resolvedAt",
            "summarizeBy": "none",
